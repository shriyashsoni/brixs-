# 4. BACKEND SERVER & HOSTING
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000

# Optional Admin API Key for protected endpoints
