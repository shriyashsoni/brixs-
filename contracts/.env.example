# -----------------------------------------------------------------------------
# 3. WORLD ID BIOMETRIC CREDENTIALS & 2FA
# -----------------------------------------------------------------------------
# World ID App ID from Developer Portal
WORLD_ID_APP_ID=app_82dd2ec108a50eb98ce9fc4092d3ef1a

# World ID Action Name
WORLD_ID_ACTION=agent-high-value-auth

# Mode: "cloud" (API verifier) or "dev" (local testing)
WORLD_ID_VERIFY_MODE=cloud

# Credential level required: "device" or "orb"
WORLD_ID_VERIFICATION_LEVEL=device

# Set to "true" during local development to use MockWorldID verifier
USE_MOCK_WORLD_ID=true

# Official Sepolia World ID Router contract
WORLD_ID_SEPOLIA_ROUTER=0x719683F13Eeea7D84fCBa5d7d17Bf82e03E3d260

# Dollar threshold triggering World ID 2FA ($1,000 USD default)
BIOMETRIC_THRESHOLD_USD=1000


