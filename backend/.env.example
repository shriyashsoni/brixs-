# =====================================================================
# AegisNet backend configuration
# Copy to backend/.env and fill in. Never commit the real .env.
# =====================================================================

# --- Server ----------------------------------------------------------
PORT=4000
# production enables: 0.0.0.0 binding, locked admin routes, strict CORS
NODE_ENV=development
# Public URL(s) allowed to call the API cross-origin in production (comma separated).
# Leave empty when the backend serves the frontend itself (same origin).
PUBLIC_ORIGIN=

# --- Chain -----------------------------------------------------------
# Sepolia RPC (Alchemy / Infura). An archive-capable RPC lets the indexer find the deploy block.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
CHAIN_ID=11155111
# Relayer key: signs World ID attestations. MUST be the AegisExecutionManager relayerSigner
# (the deployer, unless changed with setRelayerSigner). Keep it funded only if you use admin routes.
PRIVATE_KEY=0x_YOUR_RELAYER_PRIVATE_KEY
ENS_ROOT_NAME=shriyash.eth
# Optional: first block to index (skips auto-detection)
INDEXER_START_BLOCK=

# Contract addresses are read from src/config/contracts.json (written by the Sepolia deploy).
# Override individually if needed:
# CONTRACT_REGISTRY=
# CONTRACT_WORLD_ID=
# CONTRACT_EXECUTION_MANAGER=
# CONTRACT_SWAPVM_ADAPTER=
# CONTRACT_UNISWAP_HOOK=

# --- World ID (https://developer.worldcoin.org) ------------------------
WORLD_ID_APP_ID=app_YOUR_APP_ID
# Create this action in the Developer Portal with "unlimited" verifications per user
WORLD_ID_ACTION=agent-high-value-auth
# cloud = real proofs checked with World's API (default). dev = no proof check, local testing only.
WORLD_ID_VERIFY_MODE=cloud
# device = any World App user; orb = Orb-verified humans only
WORLD_ID_VERIFICATION_LEVEL=device
BIOMETRIC_THRESHOLD_USD=1000

# --- AI (Claude) -------------------------------------------------------
# Enables the Claude strategy planner; falls back to deterministic rules when unset
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- 1inch (optional) --------------------------------------------------
# Live mainnet price quotes for plans
ONEINCH_API_KEY=

# --- Admin -------------------------------------------------------------
# Required in production to use routes that make the backend wallet send transactions
# (bots, scripts). Send it as the x-api-key header. The console never needs it.
ADMIN_API_KEY=
